import java.util.Scanner;

public class MainClass
{
    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);

        System.out.print("Въведете броя на студентите: ");
        int n = scanner.nextInt();
        scanner.nextLine();

        Student[] students = new Student[n];

        for (int i = 0; i < n; i++) {
            System.out.println("\nСтудент " + (i + 1));

            System.out.print("Име: ");
            String ime = scanner.nextLine();

            System.out.print("Факултетен номер: ");
            String fakNomer = scanner.nextLine();

            System.out.print("Оценка: ");
            double ocenka = scanner.nextDouble();
            scanner.nextLine();

            students[i] = new Student(ime, fakNomer, ocenka);
        }
        boolean found = false;

        System.out.println("\nСтуденти, издържали успешно изпита:");
        for (int i = 0; i < n; i++) {
            if (students[i].grade >= 3) {
                students[i].printInfo();
                found = true;
            }
        }
    }
}
